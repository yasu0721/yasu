# このファイルを .env にコピーして値を設定してください(.envはgit管理外)。

# --- データベース(SQLite。通常は変更不要) ---
DATABASE_URL="file:./dev.db"

# --- Claude API(生成に使用) ---
# 未設定の場合、生成候補はモック文言になります(動作確認は可能)。
ANTHROPIC_API_KEY=
# 既定値: claude-opus-5
ANTHROPIC_MODEL=

# --- X (Twitter) API ---
# 4つとも未設定の場合、投稿の取得・投稿はモックデータ/モック投稿で動作します。
# spec/README.md の「ステップ1」を参照して developer.x.com で発行してください。
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
